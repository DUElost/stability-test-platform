# Stability Test Platform Agent 配置文件
# 复制此文件为 .env 并根据实际情况修改配置

# ============================================
# 服务器配置
# ============================================
# 后端服务器地址
# - 生产 / 预发布 Linux 控制平面：使用固定域名或固定 IP（如 http://203.0.113.15:8000）
# - WSL / 本机开发联调：使用 http://127.0.0.1:8000
API_URL=http://127.0.0.1:8000

# ============================================
# 主机配置
# ============================================
# 主机 ID（推荐：节点 IPv4 点转横杠，如 198.51.100.6 → 198-51-100-6）
# - 必须与后端 hosts.id 一致；安装脚本会按本机 IP 给出建议值
# - 仅临时实验环境才建议启用 AUTO_REGISTER_HOST=true（控制面按上报 IP 分配）
HOST_ID=198-51-100-6
AUTO_REGISTER_HOST=false

# ── ADR-0026 Step 5b: 并发模型（新语义） ──
# 注意：MAX_CONCURRENT_TASKS 已废弃 — 不再限制同时运行的 Job 数。
# 全部入场设备都可以是 RUNNING；瞬时脚本/ADB 并发由 OperationScheduler 独立限制。

# Worker 线程池大小（默认 50，覆盖本 host 全部设备）
# STP_JOB_WORKER_POOL_SIZE=50

# 每 host 瞬时脚本/ADB 并发上限（默认 5，可热调）
# STP_MAX_CONCURRENT_OPERATIONS=5
# 认领上限（默认 5，与上者对齐；#483）：agent 一次认领的 job 数不超过此值，
# 防止同 host 大批次把全部设备一次认领 → worker 池过大 → USB 重枚举风暴。
# 需要更高认领并行时显式调大（如 8）。
# STP_MAX_CLAIM_SLOTS=5
# 后台 Coordinator 心跳间隔（秒，默认 30）
# COORDINATOR_HEARTBEAT_INTERVAL=30

# INIT→PATROL 阶段屏障（同 PlanRunHost 设备对齐后再开长跑；默认开启）
# STP_PHASE_BARRIER_ENABLED=1
# 屏障等待上限（秒，默认 600）。**不是独立旋钮**：只有先到者在等，所以它要覆盖
# 同 host 的 init 落差 ≈ (ceil(设备数 / STP_MAX_CONCURRENT_OPERATIONS) − 1) × 单设备 init 耗时。
# 23 台 / cap=5 ⇒ 系数 4，即 600s 只够单设备 init ≤2.5min。含长耗时前置步骤
# （自动刷机等）时，优先在 Plan 上配 barrier_timeout_seconds，本项只作全平台兜底。
# STP_BARRIER_TIMEOUT_SECONDS=600

# 单步骤墙钟兜底上限（秒）。优先级：PlanStep.timeout_seconds > 本项 > 300。
# 这是**安全网**不是完成判据；真正判断"还在不在推进"要靠停滞判据（#115）。
# 判定精度 ±1s（主线程轮询间隔）。
# 0 = 不限（2026-08-04 起按步骤开门）：**只对已接入 PROGRESS 打戳且显式配了
# stall_seconds 的步骤安全**（如 flash v1.1.0、monkey_setup v2.3.1 的 push/fill）。
# 没打戳的步骤配 0 仍是"卡死永远占住一个 permit"（执行心跳由独立线程发，
# 脚本 hang 住时照常上报，无机制回收）。负数视为配错，回退 300。
# STP_STEP_WALL_CLOCK_SECONDS=300

# 停滞钟（#115 阶段 1）：步骤多久没有推进算卡死。解析：PlanStep.stall_seconds > 本项 > 0(关闭)。
# **缺省 0 = 关闭，且这个缺省是承重的**：全部脚本都 capture_output=True 吞掉子进程输出，
# 实测 14/17 个全程零输出 —— "任意输出=活"在当前脚本集上等价于"全体判死"。
# 只能在脚本已接入 PROGRESS 打戳(阶段 2)后，逐个 PlanStep 显式打开。
# **本项是全机(fleet)开关**：设置了就作用于所有未显式配 stall_seconds 的步骤，
# 绕过逐个 PlanStep 的灰度闸门 —— 阶段 2 打戳完成前不要设置，否则 fleet 级误杀。
# 停滞判据的精度是 stall_seconds ± 1s(主线程轮询间隔)。
# STP_STEP_STALL_SECONDS=0

# ADR-0026 P0: 采纳控制面 heartbeat_interval_seconds 时的钳位（秒）
# STP_HEARTBEAT_INTERVAL_MIN=10
# STP_HEARTBEAT_INTERVAL_MAX=120

# ADR-0026 P2-2: 实时 step_log 批量化 + 背压
# STP_STEP_LOG_STREAM=1
# STP_LOG_BATCH_MAX_LINES=50
# STP_LOG_BATCH_FLUSH_MS=200

# 旧变量（仅向后兼容，不再用于并发控制）
# MAX_CONCURRENT_TASKS=2

# ============================================
# 采集配置
# ============================================
# 心跳间隔（秒）- 建议设置为 10
POLL_INTERVAL=10

# 挂载点检查（逗号分隔，留空则不检查）
# 示例：/mnt/data,/mnt/logs,/mnt/sdcard
MOUNT_POINTS=

# ============================================
# ADB 配置
# ============================================
# ADB 可执行文件路径
ADB_PATH=adb

# ADB 服务端口（默认 5037）
# WSL 环境下若默认端口被占用需切换端口（如 5039），必须在此配置，
# 否则 sudo 运行 agent 时无法继承 shell 中设置的 ANDROID_ADB_SERVER_PORT
# Agent 启动/reload_config 时会收敛到本端口：清理其他端口的游离 adb fork-server
# 并重启本端口 server，USB 设备才会全部重新注册（#160）。运行期检测到多 server
# 时心跳 health 置 DEGRADED；STP_ADB_AUTO_REPAIR=1 且无活动 Job 可自动修复。
# STP_STATIC_DEVICE_SERIALS 冒烟模式下跳过收敛，不碰真实 adb。
# ANDROID_ADB_SERVER_PORT=5037
# 运行期检测到多 ADB server 时自动收敛（默认 0；仅无活动 Job 且冷却期满执行）
# STP_ADB_AUTO_REPAIR=0
# STP_ADB_REPAIR_COOLDOWN_SECONDS=300

# ============================================
# 日志配置
# ============================================
# 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================
# 可选：高级配置
# ============================================
# 任务执行超时时间（秒）
TASK_TIMEOUT=3600

# 单次拉取任务数量上限
BATCH_SIZE=10

# 设备发现超时时间（秒）
DEVICE_DISCOVERY_TIMEOUT=30

# 设备锁租约时长（秒，锁过期后 watchdog 回收设备）
# DEVICE_LOCK_LEASE_SECONDS=600

# 锁续期间隔（秒）
# AGENT_LOCK_RENEWAL_INTERVAL=60

# ============================================
# WebSocket 配置
# ============================================
# Agent WebSocket 连接到后端的 URL（自动从 API_URL 推导，通常不需要手动设置）
# WS_URL=ws://127.0.0.1:8000/ws/agent

# Agent 认证密钥（需与后端 AGENT_SECRET 环境变量一致）
# AGENT_SECRET=

# pip 镜像地址（热更新 requirements.txt 变化时由控制平面注入 PIP_INDEX_URL；
# 也可在此预设，供 Agent 本机手动 pip install 使用）
# PIP_INDEX_URL=https://pypi.example.com/simple

# WebSocket 重连最大延迟（秒，指数退避上限）
# WS_RECONNECT_MAX_DELAY=30

# WebSocket ping/pong 保活间隔（秒）
# WS_PING_INTERVAL=30

# WebSocket 消息缓冲区大小（断线期间最大缓存消息数）
# WS_BUFFER_SIZE=1000

# ============================================
# 可选：资源与工具路径
# ============================================
# AIMONKEY 资源目录（热更新路径：$INSTALL_DIR/agent/resources/aimonkey）
# AIMONKEY_RESOURCE_DIR=/opt/stability-test-agent/agent/resources/aimonkey

# 外部测试工具扫描目录
# EXTERNAL_TOOL_DIR=/home/android/sonic_agent/logs/ftp_log/sonic_tinno/Test_Tool

# Agent 安装目录（通常不需要手动设置，安装脚本会自动处理）
# AGENT_INSTALL_DIR=/opt/stability-test-agent

# ============================================
# ADR-0025 Sprint 4: Dedup scan + 上送配置
# ============================================
# scan tool 的解释器与脚本路径（必须，且必须在**本机**存在）。
# 两者都会被 hot-update 覆盖，来源是控制面成对的 STP_AGENT_DEDUP_SCAN_PYTHON /
# STP_AGENT_DEDUP_SCAN_SCRIPT —— 所以控制面那两个键必须按 Agent 上的实际路径成对
# 配置，只配一个会让解释器与脚本指向不同安装。
# 路径填错会在两处报出来，别只看一处：hot-update 推送后即在远端校验，缺失项经
# 响应里的 env_paths_missing 回传，并在控制面记 ERROR + 审计；若仍发起扫描，则
# Agent 侧另有一条本地 WARNING，且 scan 子进程直接失败。
# STP_DEDUP_SCAN_PYTHON=/usr/bin/python3
# STP_DEDUP_SCAN_SCRIPT=/opt/stability_Start-Log-Scan/start_log_scan.py

# ADR-0032 D3: UNISOC archive toolchain（scan_result 需系统包 python3-xlwt）
# STP_UNISOC_LOG_SCAN_PYTHON=/usr/bin/python3
# STP_UNISOC_LOG_SCAN_SCRIPT=/mnt/stp-aee/tools/Monkey-Log-Scan-GT-SPRD/scan_log_gt.py
# STP_UNISOC_SCAN_RESULT_PYTHON=/usr/bin/python3
# STP_UNISOC_SCAN_RESULT_SCRIPT=/mnt/stp-aee/tools/Scan-Result-GT/scan_result.py
# STP_UNISOC_LOG_SCAN_POLL_SECONDS=60

# scan tool 归属地（shanghai / factory，默认 shanghai）
# STP_DEDUP_SCAN_TAG=shanghai

# Agent HDD 根目录（AEE 事件存储路径，默认 /mnt/hdd/aee_events）
# STP_AEE_LOCAL_ROOT=/mnt/hdd/aee_events

# 中心存储（CIFS）挂载点（Agent 上送目标，与控制面 STP_AEE_NFS_ROOT 同一 UNC）
# 配置后 ArtifactUploader 会把 HDD 本地产物 promote 到 {root}/jobs/{job_id}/ 再登记
# （#97：控制面只读共享根，LOCAL 路径登记必然 400）。
# STP_AEE_NFS_ROOT=/mnt/nfs/aee_events

# ADR-0032 D6：Reconciler 按 device.platform 路由（MTK/UNKNOWN → AEE，
# UNISOC → uniview，QCOM → 跳过）；原平台白名单键已随路由删除。
# UNISOC uniview Reconciler 轮询间隔（秒，默认 180）
# STP_WATCHER_UNISOC_RECONCILE_INTERVAL_SECONDS=180
# UNISOC uniview Reconciler 连续 tick 失败容忍上限（达到即停，默认 5）
# STP_WATCHER_UNISOC_RECONCILE_MAX_TICK_ERRORS=5

# DeviceLogEvent + EventUploader（ADR-0028）。单一开关，fleet 同步（#218）：
# 控制面 `.env.backend` 非空值经 hot-update 写入每台 Agent；未设则不下发。
# #287：代码默认开（=0 显式关闭）；UPLOADER_ENABLED / CONTINUOUS 双键
# 已删除——上送只走过滤模型（upload_task 标记 UPLOAD_PENDING → Agent
# 轮询上送，Agent 侧唯一执行者仍是 EventUploader/DLE）。
# STP_DEVICE_LOG_EVENT_ENABLED=1

# 上送成功后删除本机事件目录并回写 state=PRUNED（#217）。**默认 0 / 勿进 fleet。**
# 语义：先 rmtree 本地，成功后再 patch PRUNED（删除失败不改 state）。
# 风险：CIFS 事后损坏时本地已无副本；仅 1–2 台灰度验证后再扩。
# 灰度：按机写入 Agent `.env` 后 `reload_config`（读 env 即时生效，无需重启）。
# STP_EVENT_UPLOADER_PRUNE_LOCAL=0

# 终态自动 dedup 开关（1=开启, 0=关闭，默认 1）
# STP_DEDUP_AUTO_SCAN=1

# ── 刷机（flash_firmware，Honor 方向 A + v1.3.0 门控）─────────────────
# 均为 fleet 同步键：控制面 `.env.backend` 非空值经 hot-update 写入；
# 未设则不下发。缺省固件根 = {STP_NFS_ROOT}/firmware，缺省版本读
# {root}/{family}/latest.json 指针。详见 docs/design/2026-08-honor-flash-firmware-routing.md
# v1.3.0 四键：多设备门控 / 尝试次数(1..4) / 重试间隔秒 / 严格环境预检。
# STP_FLASH_FIRMWARE_ROOT=/mnt/stp-aee/firmware
# STP_FLASH_FIRMWARE_VERSION=8.0.1.100
# STP_FLASH_SKIP_IF_CURRENT=true
# STP_FLASH_VERIFY_VERSION=true
# STP_FLASH_GATE_OTHER_MTK=true
# STP_FLASH_MAX_ATTEMPTS=2
# STP_FLASH_RETRY_BACKOFF=10
# STP_FLASH_STRICT_ENV_CHECK=false
