{
  "version": 1,
  "display_name": "开关机压测",
  "specialty_key": "power-cycle",
  "status": "ready",
  "description": "Power cycle stress test (AutoTestTool): install APK, reboot loop, collect result file",
  "lifecycle": {
    "timeout_seconds": 604800,
    "init": [
      {
        "step_id": "check_device",
        "action": "script:check_device",
        "version": "1.0.2",
        "timeout_seconds": 180,
        "retry": 1,
        "params": {}
      },
      {
        "step_id": "sync_device_time",
        "action": "script:sync_device_time",
        "version": "1.0.1",
        "timeout_seconds": 60,
        "retry": 1,
        "params": {
          "timezone": "Asia/Shanghai"
        }
      },
      {
        "step_id": "unisoc_sysdump_config",
        "action": "script:unisoc_sysdump_config",
        "version": "1.0.0",
        "timeout_seconds": 60,
        "retry": 1,
        "params": {
          "enabled": true
        }
      },
      {
        "step_id": "log_prepare",
        "action": "script:log_prepare",
        "version": "1.0.0",
        "timeout_seconds": 120,
        "retry": 1,
        "params": {
          "mobilelog_size_mb": 4096,
          "ylog_size_mb": 4096
        }
      },
      {
        "step_id": "powercycle_setup",
        "action": "script:powercycle_setup",
        "version": "1.2.11",
        "timeout_seconds": 900,
        "retry": 1,
        "params": {}
      }
    ],
    "patrol": {
      "interval_seconds": 300,
      "steps": [
        {
          "step_id": "powercycle_check",
          "action": "script:powercycle_check",
          "version": "1.0.13",
          "timeout_seconds": 60,
          "retry": 0,
          "params": {}
        }
      ]
    },
    "teardown": [
      {
        "step_id": "powercycle_disarm",
        "action": "script:powercycle_disarm",
        "version": "1.0.8",
        "timeout_seconds": 660,
        "retry": 1,
        "params": {
          "mode": "disarm",
          "wait_device_online_seconds": 600
        }
      },
      {
        "step_id": "powercycle_finish",
        "action": "script:powercycle_finish",
        "version": "1.1.1",
        "timeout_seconds": 420,
        "retry": 1,
        "params": {
          "collect_attempts": 3,
          "collect_retry_wait_seconds": 120
        }
      }
    ]
  }
}
