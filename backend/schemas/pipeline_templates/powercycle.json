{
  "version": 1,
  "description": "Power cycle stress test (AutoTestTool): install APK, reboot loop, collect result file",
  "lifecycle": {
    "timeout_seconds": 604800,
    "init": [
      {
        "step_id": "check_device",
        "action": "script:check_device",
        "version": "1.0.2",
        "timeout_seconds": 180,
        "retry": 1,
        "params": {}
      },
      {
        "step_id": "powercycle_setup",
        "action": "script:powercycle_setup",
        "version": "1.2.9",
        "timeout_seconds": 900,
        "retry": 1,
        "params": {}
      }
    ],
    "patrol": {
      "interval_seconds": 300,
      "steps": [
        {
          "step_id": "powercycle_check",
          "action": "script:powercycle_check",
          "version": "1.0.10",
          "timeout_seconds": 60,
          "retry": 0,
          "params": {}
        }
      ]
    },
    "teardown": [
      {
        "step_id": "powercycle_disarm",
        "action": "script:powercycle_disarm",
        "version": "1.0.1",
        "timeout_seconds": 660,
        "retry": 1,
        "params": {
          "mode": "disarm",
          "wait_device_online_seconds": 600
        }
      },
      {
        "step_id": "powercycle_finish",
        "action": "script:powercycle_finish",
        "version": "1.1.0",
        "timeout_seconds": 420,
        "retry": 1,
        "params": {
          "collect_attempts": 3,
          "collect_retry_wait_seconds": 120
        }
      }
    ]
  }
}
