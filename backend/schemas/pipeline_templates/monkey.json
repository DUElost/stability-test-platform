{
  "version": 1,
  "display_name": "Monkey 标准长稳",
  "specialty_key": "monkey",
  "status": "ready",
  "description": "Standard Android Monkey test: run monkey with specified packages, event count, and throttle",
  "lifecycle": {
    "timeout_seconds": 604800,
    "init": [
      {
        "step_id": "check_device",
        "action": "script:check_device",
        "version": "1.0.2",
        "timeout_seconds": 180,
        "retry": 1,
        "params": {}
      },
      {
        "step_id": "sync_device_time",
        "action": "script:sync_device_time",
        "version": "1.0.1",
        "timeout_seconds": 60,
        "retry": 1,
        "params": {
          "timezone": "Asia/Shanghai"
        }
      },
      {
        "step_id": "unisoc_sysdump_config",
        "action": "script:unisoc_sysdump_config",
        "version": "1.0.0",
        "timeout_seconds": 60,
        "retry": 1,
        "params": {
          "enabled": true
        }
      },
      {
        "step_id": "ensure_root",
        "action": "script:ensure_root",
        "version": "1.0.2",
        "timeout_seconds": 180,
        "retry": 1,
        "params": {
          "max_attempts": 3
        }
      },
      {
        "step_id": "monkey_setup",
        "action": "script:monkey_setup",
        "version": "2.3.13",
        "timeout_seconds": 600,
        "retry": 1,
        "params": {}
      },
      {
        "step_id": "monkey_resource_push",
        "action": "script:monkey_resource_push",
        "version": "1.1.1",
        "timeout_seconds": 600,
        "retry": 1,
        "params": {}
      },
      {
        "step_id": "monkey_launch",
        "action": "script:monkey_launch",
        "version": "5.2.0",
        "timeout_seconds": 1200,
        "retry": 0,
        "params": {}
      }
    ],
    "patrol": {
      "interval_seconds": 300,
      "steps": [
        {
          "step_id": "monkey_check",
          "action": "script:monkey_check",
          "version": "2.0.3",
          "timeout_seconds": 60,
          "retry": 0,
          "params": {}
        }
      ]
    },
    "teardown": [
      {
        "step_id": "monkey_teardown",
        "action": "script:monkey_teardown",
        "version": "1.0.3",
        "timeout_seconds": 600,
        "retry": 0,
        "params": {}
      }
    ]
  }
}
