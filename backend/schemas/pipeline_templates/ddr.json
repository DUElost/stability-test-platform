{
  "version": 1,
  "display_name": "DDR 骨架模板",
  "specialty_key": "ops",
  "status": "skeleton",
  "description": "DDR memory test: push memtester binary, run memtester with specified size and loops",
  "lifecycle": {
    "timeout_seconds": 7200,
    "init": [
      {
        "step_id": "check_device",
        "action": "script:check_device",
        "version": "1.0.2",
        "timeout_seconds": 180,
        "retry": 1,
        "params": {}
      },
      {
        "step_id": "sync_device_time",
        "action": "script:sync_device_time",
        "version": "1.0.1",
        "timeout_seconds": 60,
        "retry": 1,
        "params": {
          "timezone": "Asia/Shanghai"
        }
      },
      {
        "step_id": "unisoc_sysdump_config",
        "action": "script:unisoc_sysdump_config",
        "version": "1.0.0",
        "timeout_seconds": 60,
        "retry": 1,
        "params": {
          "enabled": true
        }
      },
      {
        "step_id": "ensure_root",
        "action": "script:ensure_root",
        "version": "1.0.2",
        "timeout_seconds": 180,
        "retry": 1,
        "params": {
          "max_attempts": 3
        }
      }
    ],
    "teardown": []
  }
}
