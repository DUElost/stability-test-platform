{
  "version": 1,
  "display_name": "GPU 压测",
  "specialty_key": "gpu",
  "status": "ready",
  "description": "GPU stress test (Antutu): RAM-based variant split, install APK, run instrument loop, collect log",
  "lifecycle": {
    "timeout_seconds": 604800,
    "init": [
      {
        "step_id": "check_device",
        "action": "script:check_device",
        "version": "1.0.2",
        "timeout_seconds": 180,
        "retry": 1,
        "params": {}
      },
      {
        "step_id": "sync_device_time",
        "action": "script:sync_device_time",
        "version": "1.0.1",
        "timeout_seconds": 60,
        "retry": 1,
        "params": {
          "timezone": "Asia/Shanghai"
        }
      },
      {
        "step_id": "unisoc_sysdump_config",
        "action": "script:unisoc_sysdump_config",
        "version": "1.0.0",
        "timeout_seconds": 60,
        "retry": 1,
        "params": {
          "enabled": true
        }
      },
      {
        "step_id": "ensure_root",
        "action": "script:ensure_root",
        "version": "1.0.2",
        "timeout_seconds": 180,
        "retry": 1,
        "params": {
          "max_attempts": 3
        }
      },
      {
        "step_id": "gpu_setup",
        "action": "script:gpu_setup",
        "version": "1.2.4",
        "timeout_seconds": 900,
        "retry": 1,
        "params": {}
      },
      {
        "step_id": "log_prepare",
        "action": "script:log_prepare",
        "version": "1.0.0",
        "timeout_seconds": 120,
        "retry": 1,
        "params": {
          "mobilelog_size_mb": 10240,
          "ylog_size_mb": 10240
        }
      }
    ],
    "patrol": {
      "interval_seconds": 300,
      "steps": [
        {
          "step_id": "gpu_check",
          "action": "script:gpu_check",
          "version": "1.0.10",
          "timeout_seconds": 60,
          "retry": 0,
          "params": {}
        }
      ]
    },
    "teardown": [
      {
        "step_id": "gpu_disarm",
        "action": "script:gpu_disarm",
        "version": "1.0.0",
        "timeout_seconds": 1200,
        "retry": 1,
        "params": {
          "mode": "disarm",
          "wait_device_online_seconds": 600
        }
      },
      {
        "step_id": "gpu_finish",
        "action": "script:gpu_finish",
        "version": "1.1.0",
        "timeout_seconds": 600,
        "retry": 1,
        "params": {}
      }
    ]
  }
}
