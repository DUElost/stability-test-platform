{
  "version": 1,
  "description": "Sleep wakeup stress test (AutoTestTool): install APK, run sleep/wake cycles, collect result file",
  "lifecycle": {
    "timeout_seconds": 604800,
    "init": [
      {
        "step_id": "check_device",
        "action": "script:check_device",
        "version": "1.0.0",
        "timeout_seconds": 30,
        "retry": 1,
        "params": {}
      },
      {
        "step_id": "sleep_setup",
        "action": "script:sleep_setup",
        "version": "1.0.0",
        "timeout_seconds": 900,
        "retry": 1,
        "params": {}
      }
    ],
    "patrol": {
      "interval_seconds": 300,
      "steps": [
        {
          "step_id": "sleep_check",
          "action": "script:sleep_check",
          "version": "1.0.0",
          "timeout_seconds": 60,
          "retry": 0,
          "params": {}
        }
      ]
    },
    "teardown": [
      {
        "step_id": "sleep_finish",
        "action": "script:sleep_finish",
        "version": "1.0.0",
        "timeout_seconds": 600,
        "retry": 1,
        "params": {}
      }
    ]
  }
}
