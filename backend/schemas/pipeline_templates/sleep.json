{
  "version": 1,
  "display_name": "休眠唤醒压测",
  "specialty_key": "sleep",
  "status": "ready",
  "description": "Sleep wakeup stress test (AutoTestTool): install APK, run sleep/wake cycles, collect result file",
  "lifecycle": {
    "timeout_seconds": 604800,
    "init": [
      {
        "step_id": "check_device",
        "action": "script:check_device",
        "version": "1.0.2",
        "timeout_seconds": 180,
        "retry": 1,
        "params": {}
      },
      {
        "step_id": "sync_device_time",
        "action": "script:sync_device_time",
        "version": "1.0.1",
        "timeout_seconds": 60,
        "retry": 1,
        "params": {
          "timezone": "Asia/Shanghai"
        }
      },
      {
        "step_id": "unisoc_sysdump_config",
        "action": "script:unisoc_sysdump_config",
        "version": "1.0.0",
        "timeout_seconds": 60,
        "retry": 1,
        "params": {
          "enabled": true
        }
      },
      {
        "step_id": "log_prepare",
        "action": "script:log_prepare",
        "version": "1.0.0",
        "timeout_seconds": 120,
        "retry": 1,
        "params": {
          "mobilelog_size_mb": 4096,
          "ylog_size_mb": 4096
        }
      },
      {
        "step_id": "sleep_setup",
        "action": "script:sleep_setup",
        "version": "1.0.6",
        "timeout_seconds": 900,
        "retry": 1,
        "params": {}
      }
    ],
    "patrol": {
      "interval_seconds": 300,
      "steps": [
        {
          "step_id": "sleep_check",
          "action": "script:sleep_check",
          "version": "1.0.6",
          "timeout_seconds": 60,
          "retry": 0,
          "params": {}
        }
      ]
    },
    "teardown": [
      {
        "step_id": "sleep_finish",
        "action": "script:sleep_finish",
        "version": "1.0.6",
        "timeout_seconds": 600,
        "retry": 1,
        "params": {}
      }
    ]
  }
}
