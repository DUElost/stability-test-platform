{
  "version": 1,
  "display_name": "MTBF 稳定性",
  "specialty_key": "mtbf",
  "status": "ready",
  "requires_suite": true,
  "description": "MTBF test: push resources, install APK, run instrumentation test, collect logs (requires bound MTBF suite)",
  "lifecycle": {
    "timeout_seconds": 604800,
    "init": [
      {
        "step_id": "check_device",
        "action": "script:check_device",
        "version": "1.0.2",
        "timeout_seconds": 180,
        "retry": 1,
        "params": {}
      },
      {
        "step_id": "sync_device_time",
        "action": "script:sync_device_time",
        "version": "1.0.1",
        "timeout_seconds": 60,
        "retry": 1,
        "params": {
          "timezone": "Asia/Shanghai"
        }
      },
      {
        "step_id": "unisoc_sysdump_config",
        "action": "script:unisoc_sysdump_config",
        "version": "1.0.0",
        "timeout_seconds": 60,
        "retry": 1,
        "params": {
          "enabled": true
        }
      },
      {
        "step_id": "ensure_root",
        "action": "script:ensure_root",
        "version": "1.0.2",
        "timeout_seconds": 180,
        "retry": 1,
        "params": {
          "max_attempts": 3
        }
      },
      {
        "step_id": "log_prepare",
        "action": "script:log_prepare",
        "version": "1.0.0",
        "timeout_seconds": 120,
        "retry": 1,
        "params": {
          "mobilelog_size_mb": 4096,
          "ylog_size_mb": 4096
        }
      },
      {
        "step_id": "mtbf_setup",
        "action": "script:mtbf_setup",
        "version": "1.4.2",
        "timeout_seconds": 900,
        "retry": 1,
        "params": {}
      }
    ],
    "patrol": {
      "interval_seconds": 300,
      "steps": [
        {
          "step_id": "mtbf_check",
          "action": "script:mtbf_check",
          "version": "1.5.0",
          "timeout_seconds": 60,
          "retry": 0,
          "params": {}
        }
      ]
    },
    "teardown": [
      {
        "step_id": "mtbf_finish",
        "action": "script:mtbf_finish",
        "version": "1.6.0",
        "timeout_seconds": 600,
        "retry": 1,
        "params": {}
      }
    ]
  }
}
