DATABASE_URL=postgresql+asyncpg://stp:password@localhost:5432/stp
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# CORS wildcards are rejected when credentials are enabled.
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Agent-Secret
# 限流(backend/core/limiter.py)信任 X-Forwarded-For 的来源网段,逗号分隔,
# 支持 IP 与 CIDR。只有直连对端落在这里时才采信该头,否则一律用对端 IP ——
# 否则轮换 X-Forwarded-For 即可绕过限流(#81)。
# 默认 127.0.0.1/32,::1/128:生产 uvicorn 只绑 127.0.0.1,全部流量经 nginx
# 抵达,该默认值即可覆盖。若改为独立 LB / 多层代理,把各层网段都列进来。
# 设为空字符串 = 完全不信任 XFF(没有反代、直接暴露时的正确选择)。
# STP_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# API 文档开关(G22):0/false/no/off 之外的非法值也按关处理;未设置或空 = 开。
# 关闭时 /docs /redoc /openapi.json 一并下线(schema 与交互式 UI 属同一暴露面),
# 脚本客户端走 POST /api/v1/auth/token + bearer 不受影响。控制面对公网开放前应置 0。
# STP_API_DOCS_ENABLED=1
SSH_CREDENTIALS_FERNET_KEY=
# STP_SSH_KNOWN_HOSTS=/etc/stp/known_hosts
# STP_SSH_LOG_ROOTS=/opt/stability-test-agent/logs,/var/log

# 旧名 HEARTBEAT_TIMEOUT_SECONDS / HEARTBEAT_CHECK_INTERVAL_SECONDS 与
# BACKPRESSURE_*（Phase 4 已移除 Redis 背压，见 agent_api._get_backpressure）
# 均无读取点，已于 #737 移除；心跳超时的真实开关见下方 HOST/RUNNING/... 三项。

# Control-plane local prefix only (not 中心存储). Must not be used as script
# catalog root — set STP_SCRIPT_ROOT. Agent STP_NFS_ROOT is mirrored from
# STP_AEE_NFS_ROOT by hot-update for legacy scripts.
# STP_NFS_ROOT=/mnt/storage/test-platform

# Script catalog scan source. Required; scan returns 503 if unset.
# STP_SCRIPT_ROOT=F:\stability-test-platform\backend\agent\scripts

# Runtime root used by Linux agents after hot update. If set, script scan stores
# this path in script.nfs_path instead of the platform host's local scan path.
# STP_SCRIPT_RUNTIME_ROOT=/opt/stability-test-agent/agent/scripts

# Session watchdog (replaces overlapping recycler + heartbeat monitor checks)
# 常驻调度（session_watchdog_once），无开关；USE_SESSION_WATCHDOG 无读取点，已移除（#737）。
# Long patrol + scan may delay HTTP heartbeat; 300s recommended for real-device hosts.
HOST_HEARTBEAT_TIMEOUT_SECONDS=300
# PENDING→RUNNING 心跳超时（默认 900s；RUN_HEARTBEAT_TIMEOUT_SECONDS 为兼容别名）
# RUNNING_HEARTBEAT_TIMEOUT_SECONDS=900
# Patrol 运行心跳超时（默认 300s；非生产环境默认 180s）
# PATROL_RUNNING_HEARTBEAT_TIMEOUT_SECONDS=300
UNKNOWN_GRACE_SECONDS=300
SESSION_WATCHDOG_INTERVAL_SECONDS=15

# WebSocket auth (see ADR-0009)
# ENV=development, internal or production.
# /dashboard SocketIO 在 TESTING!=1 时一律要求有效认证(access token /
# HttpOnly cookie / 显式配置的 WS_TOKEN),与 ENV 取值无关(#281 P0)。
# ENV=internal = 无 TLS 内网部署(#281 部署决策):AUTH_COOKIE_SECURE 不强
# 制(纯 HTTP 下 Secure cookie 被浏览器拒绝),但 CSRF / SameSite 校验 /
# SocketIO 强制认证 / 注册默认关闭 / STP_SKIP_INFRA_CHECK 禁用全部保留;
# 上 TLS 后置 AUTH_COOKIE_SECURE=1 并考虑收紧。
ENV=development
# Static shared secret for browser WS token validation (fallback when JWT unavailable)
WS_TOKEN=change-me-in-production
# Agent WS authentication secret (must match agent-side AGENT_SECRET)
AGENT_SECRET=change-me-in-production
# 平台 AI 助手（ADR-0031）：API Key Fernet 加密密钥（独立密钥域，勿复用 SSH_CREDENTIALS_FERNET_KEY）
# 未配置时 AI 助手功能降级（config 接口报未配置），不影响平台其余功能。
# 生产控制面即 PG 宿主机：T1 工具（run_agent_tests / run_gates）在本机消耗算力，
# 不触生产库写操作，但须评估是否对全部登录用户开放——默认 T1 自动执行见 ADR-0031 D1。
# AI_ASSISTANT_FERNET_KEY=

# Agent claim version floor (POST /api/v1/agent/jobs/claim → 426 when below).
# Leave unset during rollout so old Agents keep claiming; set after fleet upgrade.
# STP_AGENT_MIN_VERSION=2.0.0

# ============================================
# Agent 热更新 / 首次安装
# ============================================
# Agent 主机 pip 镜像地址（热更新 requirements.txt 变化时注入 PIP_INDEX_URL）。
# 留空则用 pip 默认 index（公网 PyPI）。Agent 主机无法访问公网时填内网镜像。
# STP_AGENT_PIP_INDEX_URL=https://pypi.example.com/simple

# 控制平面预置 wheel 目录（首次安装离线兜底；Agent 主机无 pip 镜像时使用）。
# STP_AGENT_WHEELHOUSE=/opt/stp-wheelhouse

# ============================================
# ADR-0025 Sprint 4: Dedup scan + NFS 配置
# ============================================
# 中心存储（CIFS）本机挂载点（后端与 Agent 共享同一 UNC，路径字符串可不同）。
# 控制面必须显式设；未设时 /api/v1/stats/file-server 返回 503
# （backend/services/file_server_monitor.py:_require_shared_root）。
# 过渡期 UNC 在控制面同机 //192.0.2.202/jxtinno/sonic_tinno；目标 15.4 或 9.4。
# STP_AEE_NFS_ROOT=/mnt/nfs/aee_events

# ADR-0028 DeviceLogEvent + EventUploader（fleet 同步到 Agent，#218）
# 控制面非空值经 hot-update 写入每台 Agent `.env`；未设则不下发。
# #287：单一开关，代码默认开（=0 显式关闭）；UPLOADER_ENABLED /
# CONTINUOUS 双键已删除——上送只走过滤模型（upload_task 标记
# UPLOAD_PENDING → Agent 轮询上送）。
# STP_EVENT_UPLOADER_PRUNE_LOCAL **禁止**写入控制面 fleet 同步键 / `.env.backend` 下发列表（#217）：
# 误 prune 或 CIFS 失败后本地无副本。仅按机 SSH 写入 Agent `.env` 灰度。
# STP_DEVICE_LOG_EVENT_ENABLED=1

# 共享存储健康页（侧栏「文件服务器」）双栏配置。
# 左栏「控制面」展示 IP：不是 CIFS 根 / UNC，切盘后也保持控制面自身。
# STP_FILE_SERVER_ADDRESS=192.0.2.202
# STP_PROMETHEUS_URL=http://127.0.0.1:9091
# 左栏控制面的 node exporter Prometheus job（旧名保留为回落）。
# STP_CONTROL_PLANE_NODE_JOB=file-server
# STP_FILE_SERVER_AGENT_FRESH_SECONDS=180
# 右栏「中心存储机」：未设 STP_AEE_SHARE_ADDRESS 时与控制面同源（过渡期同机）。
# 中心存储迁离 8.202 后必须同时设置地址与新机的 Prometheus job（#205）。
# STP_AEE_SHARE_ADDRESS=192.0.2.204
# STP_STORAGE_NODE_JOB=storage-server

# scan tool 解释器/脚本路径（后端 run_merge_sync 使用，控制面本机路径，#295）
# 控制面专用键：与 Agent 键名分离，避免共用 .env 时角色混淆。
# STP_BACKEND_DEDUP_SCAN_PYTHON=/usr/bin/python3
# STP_BACKEND_DEDUP_SCAN_SCRIPT=/opt/stability_Start-Log-Scan/start_log_scan.py
# #518 起旧无前缀键 STP_DEDUP_SCAN_PYTHON/_SCRIPT 回落已删除——控制面只认
# STP_BACKEND_DEDUP_SCAN_*（backend/services/dedup_scan.py）。

# Agent 侧的同一工具路径。控制面与 Agent 上的安装位置不同，所以必须分开配：
# 这两个才会被 hot-update 写进 Agent 的无前缀键
# STP_DEDUP_SCAN_PYTHON / STP_DEDUP_SCAN_SCRIPT。填共享挂载路径即 20 台共用一份。
# STP_AGENT_DEDUP_SCAN_PYTHON=/mnt/stp-aee/tools/Start-Log-Scan/venv/bin/python
# STP_AGENT_DEDUP_SCAN_SCRIPT=/mnt/stp-aee/tools/Start-Log-Scan/start_log_scan.py

# ADR-0032 D3: UNISOC archive toolchain (hot-update → Agent 无前缀键)
# STP_AGENT_UNISOC_LOG_SCAN_PYTHON=/mnt/automation-toolkit/python-tools/venv/bin/python
# STP_AGENT_UNISOC_LOG_SCAN_SCRIPT=/mnt/automation-toolkit/python-tools/stability_Monkey-Log-Scan-GT&SPRD/scan_log_gt.py
# STP_AGENT_UNISOC_SCAN_RESULT_PYTHON=/mnt/automation-toolkit/python-tools/venv/bin/python
# STP_AGENT_UNISOC_SCAN_RESULT_SCRIPT=/mnt/automation-toolkit/python-tools/stability_Monkey-Log-Scan-GT&SPRD/scan_result.py

# scan tool 归属地（shanghai / factory，默认 shanghai）
# STP_DEDUP_SCAN_TAG=shanghai

# 终态自动 dedup 开关（1=开启, 0=关闭，默认 1）
# STP_DEDUP_AUTO_SCAN=1

# auto_archive_sweep 轮询间隔（秒，默认 120）
# AUTO_ARCHIVE_POLL_INTERVAL_SECONDS=120
# Plan 链持久化补偿扫描间隔（秒，默认 60）
# CHAIN_RECONCILER_INTERVAL_SECONDS=60

# ============================================
# ADR-0026: Plan 准入队列（默认开启，唯一派发路径）
# ============================================
# 总开关:1=准入队列(prepare 建 QUEUED,pump 准入);0=完全禁用派发。
# 灰度步骤见 docs/operations/adr-0026-admission-and-scale-gray-rollout.md
# 开启后请确认 /health 中 admission_queue_enabled=true（flag ∧ pump ready）。
# 注意:flag 关闭后 pump 仍以 drain-only 模式消化存量 QUEUED,不会静默搁置。
# STP_PLAN_ADMISSION_QUEUE_ENABLED=1  # 0=停用新派发；不恢复 legacy inline dispatch
# pump 扫描间隔(秒,默认 5)
# STP_ADMISSION_PUMP_INTERVAL_SECONDS=5
# 每拍最多准入的 PlanRun 数(默认 5)
# STP_ADMISSION_PUMP_BATCH=5
# 准入竞争回队的重试退避(秒,默认 30)
# STP_ADMISSION_RETRY_BACKOFF_SECONDS=30
# 防饿 aging:每等待 N 秒等效提升 1 点优先级(默认 1800),上限 boost(默认 5,0=关闭)
# STP_ADMISSION_AGING_STEP_SECONDS=1800
# STP_ADMISSION_AGING_MAX_BOOST=5
# PRECHECK 中断恢复(reaper):最大重试次数(默认 3)与线性退避基数(秒,默认 60)
# MAX_ADMISSION_REQUEUE_ATTEMPTS=3
# ADMISSION_REQUEUE_BACKOFF_SECONDS=60
# WAITING_*/PATROL_SLEEP 子状态的 Coordinator 心跳超时(秒,默认 300;Step 5b Agent 上报后生效)
# COORDINATOR_HEARTBEAT_TIMEOUT_SECONDS=300

# ADR-0026 P0/P2: SAQ producer 与 in-process worker 解耦
# STP_ENABLE_INPROCESS_SAQ=1          # 0=仅 producer，需外部 worker 同队列消费
# DEVICE_SNAPSHOT_INTERVAL=30         # 心跳硬件字段降采样间隔(秒)
# STP_HEARTBEAT_INTERVAL_BASE=20      # 建议 Agent 心跳周期(随在线设备缓增)
# STP_HEARTBEAT_INTERVAL_MIN=15
# STP_HEARTBEAT_INTERVAL_MAX=60
# STP_LOG_RATE_LIMIT_BASE=200         # 建议每 host step_log 行速率上限(随设备收紧)
# STP_LOG_RATE_LIMIT_MIN=20
# STP_COUNTER_RECONCILE_INTERVAL_SECONDS=300  # O(1) 计数器对账 sweep
# ADR-0027 P3-1: 多实例时 singleton APScheduler job 的 leader election（默认开；单实例无感）
# STP_SCHEDULER_LEADER_ELECTION=1
# ADR-0027 P3-2: SocketIO Redis adapter（默认关；多实例时再开）
# STP_SOCKETIO_REDIS_ADAPTER=0
# STP_SOCKETIO_REDIS_CHANNEL=stp-socketio
# ADR-0027 P3-3: Agent sid 跨实例登记（默认跟随 adapter；显式 0/1 可覆盖）
# STP_AGENT_SID_REGISTRY=
# STP_AGENT_SID_REGISTRY_TTL_SECONDS=120

# ============================================
# Alembic downgrade 数据保护
# ============================================
# 数据迁移类 migration 的 downgrade 会全表 DELETE/drop 核心表（plan_run/plan 等），
# 误执行丢数据且不可恢复。guard_nonempty 在 downgrade 检测到目标表非空时抛错阻止。
# 确需强制回退（明确接受数据丢失）时设为 1：
#   STP_ALLOW_DESTRUCTIVE_DOWNGRADE=1 python -m alembic downgrade <rev>
# STP_ALLOW_DESTRUCTIVE_DOWNGRADE=0

# ── 刷机 fleet 下发源键（flash_firmware，Honor 方向 A + v1.3.0 门控）──
# 控制面非空值经 hot-update fleet 白名单写入每台 Agent 的同名无前缀键；
# 未设则不下发（Agent 走 latest.json 指针与代码默认）。
# v1.3.0 四键：多设备门控 / 尝试次数(1..4) / 重试间隔秒 / 严格环境预检。
# STP_FLASH_FIRMWARE_VERSION=8.0.1.100
# STP_FLASH_FIRMWARE_ROOT=/mnt/stp-aee/firmware
# STP_FLASH_SKIP_IF_CURRENT=true
# STP_FLASH_VERIFY_VERSION=true
# STP_FLASH_GATE_OTHER_MTK=true
# STP_FLASH_MAX_ATTEMPTS=2
# STP_FLASH_RETRY_BACKOFF=10
# STP_FLASH_STRICT_ENV_CHECK=false

# ── 控制面运行时调优（#960 / #1122 / #1124）──
# 升级维护窗口兜底 TTL 秒（默认 900，上限 3600）：持有进程崩溃后窗口按此过期
# STP_HOST_MAINTENANCE_TTL_SECONDS=900
# 通知 SMTP 网络 deadline 秒（默认 15）
# STP_SMTP_TIMEOUT_SECONDS=15
# 后台线程池待提交队列上限（默认 200）：满即拒绝，不再无界堆积
# BACKGROUND_POOL_MAX_QUEUE=200
# RunConsole replay 单次回放行数上限（默认 2000）
# STP_RUN_CONSOLE_REPLAY_MAX_LINES=2000
# RunConsole 终态运行记录保留秒数（默认 3600）
# STP_RUN_CONSOLE_TERMINAL_RETENTION_SECONDS=3600

# ============================================
# 运行调优与集成（#737 登记：默认值即代码默认，需要时取消注释覆盖）
# ============================================

# -- 调度节奏（秒） --
# RUN_RECYCLE_INTERVAL_SECONDS=30    # recycler 超时回收扫描周期
# RECONCILER_INTERVAL_SECONDS=15    # 租约/心跳对账周期
# CRON_POLL_INTERVAL=30    # cron 计划轮询周期
# RETENTION_CLEANUP_INTERVAL_SECONDS=3600    # 保留期清理 sweep 周期
# QUEUE_DEPTH_POLL_INTERVAL_SECONDS=15    # 队列深度采样周期
# PRECHECK_REAPER_INTERVAL_SECONDS=45    # precheck 僵尸回收周期
# REVOKED_TOKEN_CLEANUP_INTERVAL_SECONDS=86400    # 撤销 token 清理周期
# STP_SIGNAL_LINK_RECONCILE_INTERVAL_SECONDS=300    # job_log_signal↔device_log_event 补链 sweep 周期

# -- 批量与并发上限 --
# RECYCLER_BATCH_SIZE=200    # recycler 每轮处理条数
# CHAIN_RECONCILE_BATCH_SIZE=100    # 链式重派每轮扫描条数
# PATROL_STALL_BATCH_LIMIT=100    # patrol 停滞判定每轮条数
# STP_COUNTER_RECONCILE_BATCH=200    # 计数器对账每轮条数
# STP_COUNTER_RECONCILE_LOOKBACK_HOURS=48    # 计数器对账回看窗口（小时）
# STP_SIGNAL_LINK_RECONCILE_BATCH=200    # 信号补链每轮条数
# BACKGROUND_POOL_SIZE=8    # 后台线程池并发（DB/IO 类任务）
# SAQ_CONCURRENCY=10    # 进程内 SAQ worker 并发
# SAQ_ENQUEUE_WAIT_TIMEOUT=5.0    # 入队等待超时（秒）
# MAX_PRECHECK_REENQUEUE_ATTEMPTS=1    # precheck 重排队最大次数

# -- 保留期（天） --
# PLAN_RUN_RETENTION_DAYS=3    # PlanRun 及明细保留天数
# ARTIFACT_RETENTION_DAYS=30    # 制品/归档保留天数

# -- 阈值与宽限（秒/次） --
# POST_COMPLETION_GRACE_SECONDS=120    # 完成后的收尾宽限
# POST_COMPLETION_MAX_DEFER_SECONDS=21600    # #1175：post-completion 重试的停止窗口（grace 之后，超窗停止重试并告警留痕）
# SCHEDULE_DEDUP_WINDOW_SECONDS=60    # 计划触发去重窗口
# DEVICE_OFFLINE_TIMEOUT=60    # 设备离线判定超时
# RUN_REPORT_ALERT_ANR_THRESHOLD=1    # RUN 报告 ANR 告警阈值
# RUN_REPORT_ALERT_CRASH_THRESHOLD=1    # RUN 报告崩溃告警阈值
# RUN_REPORT_ALERT_RESTART_THRESHOLD=2    # RUN 报告重启告警阈值

# -- 外部集成 --
# SMTP_HOST=    # 邮件通知 SMTP 主机（空 = 关闭邮件通道）
# SMTP_PORT=587    # SMTP 端口
# SMTP_USER=    # SMTP 用户名
# SMTP_PASSWORD=    # SMTP 密码
# SMTP_FROM=    # 通知发件人
# STP_JIRA_BASE_URL=    # JIRA REST 基址（可选，配合下一个 token）
# STP_JIRA_TOKEN=    # JIRA Bearer token（可选）
# RUN_REPORT_JIRA_PROJECT_KEY=STABILITY    # RUN 报告默认 JIRA 项目键
# RUN_REPORT_JIRA_TEMPLATE_JSON=    # RUN 报告 JIRA 模板覆盖（JSON）

# -- 认证与 Cookie（ADR-0024） --
# AUTH_ACCESS_COOKIE_NAME=stp_access_token    # 访问 token Cookie 名
# AUTH_REFRESH_COOKIE_NAME=stp_refresh_token    # 刷新 token Cookie 名
# AUTH_COOKIE_PATH=/    # Cookie Path
# STP_ALLOW_REGISTER=    # 公开注册开关（生产保持空/关）

# -- RunConsole 多实例（ADR-0027） --
# STP_CONSOLE_REGISTRY=    # 归属注册表（默认跟随 Redis adapter）
# STP_CONSOLE_REGISTRY_TTL_SECONDS=    # console 互斥/owner key TTL（默认 120，下限 30）
# STP_CONSOLE_CANCEL_TTL_SECONDS=    # 取消请求位/ack TTL（默认 60，下限 10）
# STP_CONSOLE_CONTROL_TICK_SECONDS=    # console 控制 tick（默认 1s）
# STP_RUN_CONSOLE_CANCEL_WAIT_SECONDS=    # 取消等待窗（默认见代码）

# -- 路径与展示 --
# LOG_BASE_DIR=data/logs    # 运行日志根目录
# STP_RUN_CONSOLE_LOG_ROOT=logs/console    # RunConsole 日志根目录
# STP_DEDUP_WORK_DIR=logs/dedup_uploads    # 去重上传工作目录
# STP_NOTIFY_SAQ_TIMEOUT_S=120    # 通知入队超时（秒）
# STP_SCRIPT_CATALOG_VERSION_CACHE_TTL=30    # 脚本目录版本缓存 TTL（秒）
# SAQ_QUEUE_NAME=stp    # SAQ 队列名（多套部署隔离用）
# STP_PLATFORM_NAME=Stability Test Platform    # 平台显示名
# STP_TIMEZONE=Asia/Shanghai    # 平台展示时区
# STP_LOG_LEVEL=INFO    # backend 应用日志级别

# -- 单机热更新（host hot-update） --
# HOT_UPDATE_ABORT_POLL_TIMEOUT_SECONDS=45    # 等待设备 drain 的超时
# HOT_UPDATE_ABORT_POLL_INTERVAL_SECONDS=1.0    # drain 轮询间隔
