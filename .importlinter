# 后端 import 边界合约（2026-09-25 架构快照产出；取代 tools/dev/check_layering.py）
#
# 运行：python scripts/run_gates.py check:quick（gate 名 layering），或
#       PYTHONPATH=. lint-imports --no-cache
# 依赖：import-linter（backend/requirements-dev.txt）。纯静态分析，不执行被检模块，全仓 <1s。
#
# 与其他门禁的关系：
#   - C1/C2 覆盖原 check_layering.py 的唯一规则（services 不得 import api.routes，#1519）；
#   - C3 是 tests/test_agent_import_boundary.py 的反方向（那边管 agent→控制面，这里管控制面→agent）；
#   - 函数体内 import 同样计入（grimp 默认口径）——#738 所说「局部 import 藏依赖」在这里可见。
#
# 棘轮规则：
#   - ignore_imports 是「已知违规基线」，只许删不许加；
#   - unmatched_ignore_imports_alerting = error：某条违规被修掉后，对应 ignore 行必须同 PR 删除，
#     否则合约失败——基线不会悄悄变成永久豁免；
#   - 新增 ignore 行视同上调棘轮：PR 描述写明 issue 号与终态出口（AGENTS.md「止血须写明终态出口」）。

[importlinter]
root_packages =
    backend
include_external_packages = True
exclude_type_checking_imports = True

# ---------------------------------------------------------------------------
# C1 控制面分层：入口适配层 > services > 下沉端口 > models > core
# ---------------------------------------------------------------------------
[importlinter:contract:c1-layers]
name = C1 控制面分层
type = layers
layers =
    backend.main
    backend.api.routes : backend.api.middleware : backend.scheduler : backend.tasks : backend.scripts
    backend.services
    backend.realtime | backend.api.schemas
    backend.models
    backend.core
unmatched_ignore_imports_alerting = error
ignore_imports =
    # S3 服务反向调用调度器实现。
    backend.services.host_upgrade_gate -> backend.scheduler.device_lease_reconciler
    # S4（core.audit → models.audit）已兑现：#3297 把审计记录写入下沉到
    # backend/services/audit_writer.py（core/audit.py 只留零依赖词表），
    # unmatched_ignore_imports_alerting=error 强制本行同 PR 删除。

# ---------------------------------------------------------------------------
# C2 services 不感知 HTTP（只查直接 import）
# 原 36 行基线分两批清零：#3295 清掉 17 行（#1520 拆分的 13 个 agent_* 文件 +
# error_helpers 4 行），#3296 清掉 14 行（plan_run_* / project_* / ai_assistant /
# device_swipe_trail / host_retirement）——两者同走「领域异常 + error_handlers
# 统一翻译」路径，对外响应逐字不变。
# 剩余 5 行均为返回 FileResponse/RedirectResponse 的下载服务（artifact_zip、
# device_log_event_download、job_artifact_download、plan_run_artifact_download），
# 出口是 services 返回文件描述、路由构造响应，另单处理。
# ---------------------------------------------------------------------------
[importlinter:contract:c2-services-no-http]
name = C2 services 不直接依赖 HTTP 层
type = forbidden
source_modules =
    backend.services
forbidden_modules =
    fastapi
    starlette
    backend.api.routes
    backend.api.error_helpers
    backend.api.error_handlers
    backend.api.middleware
    backend.api.auth_cookies
    backend.api.response
allow_indirect_imports = True
unmatched_ignore_imports_alerting = error
ignore_imports =
    backend.services.artifact_zip -> fastapi
    backend.services.artifact_zip -> starlette
    backend.services.device_log_event_download -> fastapi
    backend.services.job_artifact_download -> fastapi
    backend.services.plan_run_artifact_download -> fastapi

# ---------------------------------------------------------------------------
# C3 控制面不 import Agent 内部实现（只查直接 import）
# Agent 是独立部署单元；双方共享的定义归 `backend/agent/contracts/`（ADR-0054 D1，
# 随 agent 包与控制面同时发布）。控制面对契约包的 import 由下方通配忽略行放行，
# import agent 其他模块仍然失败。
#
# ADR-0054 第 1–4 步已把 pipeline_validator / legacy_aee / aee_metadata /
# aee_event_dirs / watcher_contracts / artifact_digest / kernel_usb_faults（解析+词表）
# 搬入 contracts/。剩余 1 条基线 = `aee/state_migration`（第 4 步的另一候选项）：
# 该模块 stdlib-only（sqlite3/json），内容以**状态键格式 + 合并语义**为主（采集/迁移
# 入口本就是控制面脚本），终态出口 = 按同一模式整体搬入 contracts/ 后删除本行；
# 搬迁前保留基线，不是永久豁免。
# `unmatched_ignore_imports_alerting = error` 强制「搬走即删行」。
# ---------------------------------------------------------------------------
[importlinter:contract:c3-cp-not-into-agent]
name = C3 控制面不直接 import backend.agent
type = forbidden
source_modules =
    backend.main
    backend.api
    backend.services
    backend.scheduler
    backend.tasks
    backend.realtime
    backend.models
    backend.core
    backend.scripts
forbidden_modules =
    backend.agent
allow_indirect_imports = True
unmatched_ignore_imports_alerting = error
ignore_imports =
    # ADR-0054 D4：共享契约包放行（零匹配会因 unmatched_ignore_imports_alerting=error
    # 报错，故本行与第一次搬迁同 PR 引入）。
    backend.** -> backend.agent.contracts.**
    backend.scripts.migrate_watcher_aee_state_keys -> backend.agent.aee.state_migration

# ---------------------------------------------------------------------------
# C4 core 是最底层：不依赖 web 框架（只查直接 import）
# #3297 基线清零：csrf / request_metrics / limiter（中间件与 RateLimiter）迁
# backend/api/middleware/（纯客户端 IP 解析留 core/limiter.py——audit 写入与
# 限流两侧都要用，core 不得上引 api）；core.audit 的写入下沉
# backend/services/audit_writer.py、core.security 的 Response cookie 操作拆到
# backend/api/auth_cookies.py，core 只留零框架依赖的纯函数。
# 原 ignore_imports 段（6 行）随清零删除——此后 core→fastapi/starlette 直接 import
# 一律红，无豁免。
# ---------------------------------------------------------------------------
[importlinter:contract:c4-core-no-web]
name = C4 core 不直接依赖 web 框架
type = forbidden
source_modules =
    backend.core
forbidden_modules =
    fastapi
    starlette
allow_indirect_imports = True
unmatched_ignore_imports_alerting = error

# ---------------------------------------------------------------------------
# C5 services 子模块之间无环（含函数体内 import）
# 现存环最少各删 1 条边即可解开，列为基线。
# ---------------------------------------------------------------------------
[importlinter:contract:c5-services-acyclic]
name = C5 services 子模块无环
type = acyclic_siblings
ancestors =
    backend.services
unmatched_ignore_imports_alerting = error
ignore_imports =
    backend.services.project_registry -> backend.services.project_mapping
    backend.services.report_service -> backend.services.log_observation
    backend.services.ai_assistant.tools -> backend.services.ai_assistant.dispatch
    backend.services.ai_assistant.tools -> backend.services.ai_assistant.plan_run_ops
