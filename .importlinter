# 后端 import 边界合约（2026-09-25 架构快照产出；取代 tools/dev/check_layering.py）
#
# 运行：python scripts/run_gates.py check:quick（gate 名 layering），或
#       PYTHONPATH=. lint-imports --no-cache
# 依赖：import-linter（backend/requirements-dev.txt）。纯静态分析，不执行被检模块，全仓 <1s。
#
# 与其他门禁的关系：
#   - C1/C2 覆盖原 check_layering.py 的唯一规则（services 不得 import api.routes，#1519）；
#   - C3 是 tests/test_agent_import_boundary.py 的反方向（那边管 agent→控制面，这里管控制面→agent）；
#   - 函数体内 import 同样计入（grimp 默认口径）——#738 所说「局部 import 藏依赖」在这里可见。
#
# 棘轮规则：
#   - ignore_imports 是「已知违规基线」，只许删不许加；
#   - unmatched_ignore_imports_alerting = error：某条违规被修掉后，对应 ignore 行必须同 PR 删除，
#     否则合约失败——基线不会悄悄变成永久豁免；
#   - 新增 ignore 行视同上调棘轮：PR 描述写明 issue 号与终态出口（AGENTS.md「止血须写明终态出口」）。

[importlinter]
root_packages =
    backend
include_external_packages = True
exclude_type_checking_imports = True

# ---------------------------------------------------------------------------
# C1 控制面分层：入口适配层 > services > 下沉端口 > models > core
# ---------------------------------------------------------------------------
[importlinter:contract:c1-layers]
name = C1 控制面分层
type = layers
layers =
    backend.main
    backend.api.routes : backend.scheduler : backend.tasks : backend.scripts
    backend.services
    backend.realtime | backend.api.schemas
    backend.models
    backend.core
unmatched_ignore_imports_alerting = error
ignore_imports =
    # S3 服务反向调用调度器实现。
    backend.services.host_upgrade_gate -> backend.scheduler.device_lease_reconciler
    # S4 core 反向依赖 models（审计写库）。出口：审计记录写入下沉到 services 或 models 侧。
    backend.core.audit -> backend.models.audit

# ---------------------------------------------------------------------------
# C2 services 不感知 HTTP（只查直接 import）
# 现状 31 个 service 直接 import fastapi，其中 21 个来自 #1520 上帝文件拆分（另 2 个来自 #1519 下沉）：
# 行数棘轮达标了，HTTP 语义（HTTPException/Request/FileResponse）随代码一起搬进了 services。
# 出口：services 抛领域异常，路由层（或一个统一 exception handler）翻译成 HTTP 状态码。
# ---------------------------------------------------------------------------
[importlinter:contract:c2-services-no-http]
name = C2 services 不直接依赖 HTTP 层
type = forbidden
source_modules =
    backend.services
forbidden_modules =
    fastapi
    starlette
    backend.api.routes
    backend.api.error_helpers
    backend.api.response
allow_indirect_imports = True
unmatched_ignore_imports_alerting = error
ignore_imports =
    backend.services.agent_archive_status -> fastapi
    backend.services.agent_artifacts -> fastapi
    backend.services.agent_artifacts -> backend.api.error_helpers
    backend.services.agent_claim -> fastapi
    backend.services.agent_completion -> fastapi
    backend.services.agent_device_log_events -> fastapi
    backend.services.agent_job_heartbeat -> fastapi
    backend.services.agent_job_heartbeat -> backend.api.error_helpers
    backend.services.agent_job_status -> fastapi
    backend.services.agent_job_status -> backend.api.error_helpers
    backend.services.agent_lease_extend -> fastapi
    backend.services.agent_log_signals -> fastapi
    backend.services.agent_patrol_heartbeat -> fastapi
    backend.services.agent_recovery -> fastapi
    backend.services.agent_step_status -> fastapi
    backend.services.agent_upgrade_gate -> fastapi
    backend.services.agent_upgrade_gate -> backend.api.error_helpers
    backend.services.ai_assistant.dispatch -> fastapi
    backend.services.ai_assistant.plan_run_ops -> fastapi
    backend.services.artifact_zip -> fastapi
    backend.services.artifact_zip -> starlette
    backend.services.device_log_event_download -> fastapi
    backend.services.device_swipe_trail -> fastapi
    backend.services.host_retirement -> fastapi
    backend.services.job_artifact_download -> fastapi
    backend.services.plan_run_archive -> fastapi
    backend.services.plan_run_artifact_download -> fastapi
    backend.services.plan_run_catalog -> fastapi
    backend.services.plan_run_job_artifacts -> fastapi
    backend.services.plan_run_manual -> fastapi
    backend.services.plan_run_queries -> fastapi
    backend.services.plan_run_read_common -> fastapi
    backend.services.plan_run_summary -> fastapi
    backend.services.plan_wifi -> fastapi
    backend.services.project_mapping -> fastapi
    backend.services.project_registry -> fastapi

# ---------------------------------------------------------------------------
# C3 控制面不 import Agent 内部实现（只查直接 import）
# Agent 是独立部署单元；双方共享的定义现在靠「控制面伸手进 agent」或「同名双份 + parity 测试 /
# try-except ImportError 兜底」维持（core/pipeline_validator.py 与 agent/pipeline_validator.py
# 字节级相同）。出口：建立一个零依赖的共享契约包（随 agent 包与控制面同时发布），
# 把 aee 路径/元数据、watcher 契约、pipeline 校验、digest 算法等移入。
# ---------------------------------------------------------------------------
[importlinter:contract:c3-cp-not-into-agent]
name = C3 控制面不直接 import backend.agent
type = forbidden
source_modules =
    backend.main
    backend.api
    backend.services
    backend.scheduler
    backend.tasks
    backend.realtime
    backend.models
    backend.core
    backend.scripts
forbidden_modules =
    backend.agent
allow_indirect_imports = True
unmatched_ignore_imports_alerting = error
ignore_imports =
    backend.core.aee_metadata -> backend.agent.aee.metadata
    backend.services.agent_log_signals -> backend.agent.watcher.contracts
    backend.services.dedup_extract -> backend.agent.aee.event_dirs
    backend.services.host_health_probe -> backend.agent.kernel_usb_faults
    backend.scripts.migrate_watcher_aee_state_keys -> backend.agent.aee.state_migration

# ---------------------------------------------------------------------------
# C4 core 是最底层：不依赖 web 框架（只查直接 import）
# ---------------------------------------------------------------------------
[importlinter:contract:c4-core-no-web]
name = C4 core 不直接依赖 web 框架
type = forbidden
source_modules =
    backend.core
forbidden_modules =
    fastapi
    starlette
allow_indirect_imports = True
unmatched_ignore_imports_alerting = error
# csrf / request_metrics / limiter 是 HTTP 中间件，出口是移到 backend/api/middleware/；
# audit / security 需拆出不依赖 Request 的纯函数部分。
ignore_imports =
    backend.core.audit -> fastapi
    backend.core.csrf -> starlette
    backend.core.limiter -> fastapi
    backend.core.limiter -> starlette
    backend.core.request_metrics -> starlette
    backend.core.security -> starlette

# ---------------------------------------------------------------------------
# C5 services 子模块之间无环（含函数体内 import）
# 现存环最少各删 1 条边即可解开，列为基线。
# ---------------------------------------------------------------------------
[importlinter:contract:c5-services-acyclic]
name = C5 services 子模块无环
type = acyclic_siblings
ancestors =
    backend.services
unmatched_ignore_imports_alerting = error
ignore_imports =
    backend.services.plan_run_aggregation -> backend.services.post_completion
    backend.services.project_registry -> backend.services.project_mapping
    backend.services.report_service -> backend.services.log_observation
    backend.services.ai_assistant.tools -> backend.services.ai_assistant.dispatch
    backend.services.ai_assistant.tools -> backend.services.ai_assistant.plan_run_ops
