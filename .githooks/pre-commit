#!/usr/bin/env bash
# stability-test-platform — pre-commit 污染拦截
#
# 用途:阻止 IDE/插件造成的"纯空行注入"或"CRLF/LF 混乱"污染入仓。
# 历史上 frontend/src/pages/orchestration/PlanEditPage.tsx 三次被
# 此类污染撞坏 diff,详见根目录 .gitattributes 注释与 README 的
# "EOL 与污染防御" 章节。
#
# 启用方式(每个开发者执行一次):
#   git config core.hooksPath .githooks
# 紧急绕过(只在确认 diff 合规时):
#   git commit --no-verify

set -e

THRESHOLD_RATIO=60       # 单次 diff:纯空行占新增行比例(%)
THRESHOLD_MIN_LINES=30   # 新增行数阈值,小于此值不判
THRESHOLD_FILE_RATIO=35  # 文件整体空行率(%)。正常代码 8~15%,污染文件 ~50%
failed=0
warnings=0

staged=$(git diff --cached --name-only --diff-filter=AM)
[ -z "$staged" ] && exit 0

while IFS= read -r file; do
  [ -z "$file" ] && continue

  # Markdown / 纯文本天然多空行,排除
  case "$file" in
    *.md|*.txt|*.rst) continue ;;
  esac

  # 二进制文件 git diff 输出极短,跳过
  if git diff --cached --numstat -- "$file" | awk '{print $1}' | grep -q '^-$'; then
    continue
  fi

  # -text 文件（.gitattributes 标记的字节级快照/夹具，如 MTBF golden XML
  # 含 CRLF 原样入库）：EOL 归一化策略不适用，全部污染检查豁免
  if [ "$(git check-attr text -- "$file" | awk '{print $NF}')" = "unset" ]; then
    continue
  fi

  diff_text=$(git diff --cached --unified=0 -- "$file" || true)
  [ -z "$diff_text" ] && continue

  # ── 检查 1:文件整体空行率 ────────────────────────────────────────────
  #
  # 必须放在最前面。下面的"新增行占比"只看单次 diff:一旦某个文件已经被
  # 污染到 ~50%,后续每次改动的新增行也维持在 ~50%,永远够不到 60% 阈值 ——
  # backend/agent/pipeline_engine.py 就是这样带着 1294/2644 的空行活了十几
  # 个提交。这里看的是**暂存后文件的最终形态**,污染文件只要被 touch 就拦,
  # 倒逼一次性清理。
  #
  # 曾经这段写在 `inserted < THRESHOLD_MIN_LINES && continue` 之后,于是改
  # 一两行的小提交会整段跳过 —— "只要被 touch 就拦"根本没实现。
  case "$file" in
    *.py|*.ts|*.tsx|*.js|*.jsx|*.sh)
      staged_content=$(git show ":$file" 2>/dev/null || true)
      if [ -n "$staged_content" ]; then
        total_lines=$(printf '%s\n' "$staged_content" | wc -l)
        # 小文件空行率波动大,不判
        if [ "$total_lines" -ge 200 ]; then
          blank_lines=$(printf '%s\n' "$staged_content" | grep -cE '^[[:space:]]*$' || true)
          file_ratio=$(( blank_lines * 100 / total_lines ))
          if [ "$file_ratio" -ge "$THRESHOLD_FILE_RATIO" ]; then
            echo "[BLOCK] $file"
            echo "        文件整体空行率 $blank_lines/$total_lines = ${file_ratio}%"
            echo "        疑似逐行空行注入污染。清理:"
            echo "          python tools/dev/collapse-blank-pollution.py '$file'"
            echo "        (该脚本仅动空行,并以 AST 比对保证语义不变)"
            failed=1
          fi
        fi
      fi
      ;;
  esac

  # ── 检查 2:CRLF 混入 LF 文件 → 注入差异源 ────────────────────────────
  # 同样必须在 min-lines 早退之前:CRLF 往往就是一两行的改动带进来的。
  if printf '%s\n' "$diff_text" | grep -qE $'\r$'; then
    echo "[BLOCK] $file: CRLF byte found in staged diff (file should be LF-only)"
    echo "        Run: tools/dev/normalize-eol.sh '$file'"
    failed=1
  fi

  # ── 检查 3:单次 diff 的新增空行占比 ──────────────────────────────────
  #
  # 新增行 = 以 + 开头但不是 +++ 文件头
  # 注意:不能用 '^\+[^+]' — 那会把"单独 +"(=纯空行污染信号)排除掉,
  # 导致 inserted=0 / blanks 永远 ≥ inserted,本来要拦截的污染漏过。
  inserted=$(printf '%s\n' "$diff_text" | grep -E '^\+' | grep -cvE '^\+\+\+' || true)
  # 纯空行新增(只含空白字符,含单独的 "+" 行)
  blanks=$(printf '%s\n' "$diff_text" | grep -cE '^\+[[:space:]]*$' || true)

  # 小改动的占比没有统计意义 —— 用 if 包住而非 continue,否则会连带跳过
  # 后面所有检查(这正是上面那两条注释记录的坑)。
  if [ "$inserted" -ge "$THRESHOLD_MIN_LINES" ]; then
    ratio=$(( blanks * 100 / inserted ))
    if [ "$ratio" -ge "$THRESHOLD_RATIO" ]; then
      echo "[BLOCK] $file"
      echo "        $blanks/$inserted = ${ratio}% pure blank-line insertions"
      echo "        Likely IDE/plugin pollution. Inspect: git diff --cached -- $file"
      failed=1
    elif [ "$ratio" -ge 40 ] && [ "$inserted" -ge 100 ]; then
      echo "[WARN ] $file: ${ratio}% blank-line insertions (>=40% over 100 lines)"
      warnings=$((warnings + 1))
    fi
  fi
done <<< "$staged"

if [ "$failed" = "1" ]; then
  echo
  echo "Commit blocked by EOL / blank-line pollution guard."
  echo "If this is intentional (rare):  git commit --no-verify"
  exit 1
fi

if [ "$warnings" -gt 0 ]; then
  echo
  echo "Pre-commit warnings: $warnings file(s). Commit allowed but review recommended."
fi

exit 0
