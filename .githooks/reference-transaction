#!/bin/sh
# stash 观测（非阻塞，#930）：refs/stash 更新在此留痕告警。
# opt-in，仅在 Git 实际使用本仓库 hooks 目录且 hook 可执行时生效：
#   git config --local core.hooksPath .githooks
# 状态 / 启用后隔离自检：<项目Python> tools/dev/check_git_hooks.py [--self-test]
# git 对 reset --hard 无干净拦截点（ref 事务无法与普通提交区分），
# 阻断层在 Claude PreToolUse（tools/dev/check_destructive_git.py）；
# 本钩子只做观测——如需硬拦截，在 prepared 阶段 exit 非零（会中止事务），
# 属独立裁决事项。
# stdin 协议（githooks(5) reference-transaction）：每行
#   <old-value> SP <new-value> SP <ref-name> LF
# 读取顺序必须是 old new ref（曾误写为 ref old new，refs/stash 永不命中）。
state=$1
while read -r old new ref; do
    case "$ref" in
        refs/stash)
            echo "[warn] refs/stash ${state}: ${old} -> ${new}" \
                "（破坏性操作纪律见 repository-workflow.md §Git 破坏性操作纪律）" >&2
            ;;
    esac
done
exit 0
