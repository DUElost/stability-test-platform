{
  "permissions": {
    "deny": [
      "Edit(.env.backend)",
      "Edit(**/.env)",
      "Edit(**/*.pem)",
      "Edit(//home/debian13/hosts.ini)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/dev/check_destructive_git.py"
          }
        ]
      }
    ]
  }
}
