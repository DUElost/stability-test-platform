# 覆盖率产物。即使把 reporter 收窄到 text(见 frontend/vitest.config.ts),
# 仍要防住 `--coverage.reporter=html` 这类手动跑法 —— 那批 coverage/*.js
# 会被 knip 判成「未被引用的文件」,直接把阻塞门禁 lint 变红。
coverage/
.coverage
.coverage.*
htmlcov/
node_modules/
.DS_Store
*.log
venv-wsl/
/logs/
# Claude Code：整目录本地态不入库；仅放行项目共享护栏（settings.json）与
# skill 试点目录。settings.local.json 仍被 .claude/* 覆盖忽略。
.claude/*
!.claude/settings.json
!.claude/skills/
# One-off nested Claude plans are local session artifacts, not project rules.
**/.claude/plan/
# UI 原型归档（HTML/PNG 设计稿，非规范；本地保留，移出 git 跟踪）
docs/archive/prototypes/
*.db-wal
*.db-shm
*.db-journal
.hypothesis/
.github/prompts/
.github/skills/
# Codex CLI 本地状态文件（忽略除 hooks.json 外的所有内容）
.codex/*
!.codex/hooks.json
# Ansible / SSH 部署本地配置（敏感清单继续忽略，其余自动化文件纳入版本控制）
tools/ansible/inventory.ini
tools/ansible/.stp-install-*.ini
tools/ansible/*.retry
.worktrees/
.docker/
/backend/agent/tools/AIMonkeyTest_20260317
.deepseek/
.superpowers/
/backend/agent/resources/
# 临时调试脚本（含明文密码/连接串等敏感信息，禁止入库）
.tmp-*.py
.tmp-*.sh
# 本地排障产物 / 外部参考脚本，不入库
patches/
MonkeyAEEinfo_260523.py
backups/

# 多工具 worktree 容器目录：防止 git add -A 把 worktree 扫成 gitlink(mode 160000)
.wt/
frontend/node_modules
