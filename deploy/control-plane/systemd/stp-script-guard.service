# Rendered by the site installer for <deploy-root> — do not edit by hand.
[Unit]
Description=STP script-version retirement guard (read-only #735 --guard probe)

[Service]
Type=oneshot
# 刻意**不写 User=**（与邻居 stp-mem-top.service 一致）：指标目录
# /var/lib/prometheus/node-exporter 属 root:root，非 root 身份写不进去，probe 会按
# 自己的契约当场失败 ⇒ timer 天天 failed。将来若要降权，得同时给该目录加 ACL 或
# 换 collector 目录，别只在这一行加 User= 就完事（2026-09-17 本机实测）。
WorkingDirectory=<deploy-root>
EnvironmentFile=<deploy-root>/.env.backend
# 只读巡检：subprocess 跑 check_unreferenced_script_versions --guard --json，把结论落成
# node-exporter textfile 指标。**这里永远不写库**——实际退役必须人工复核 manifest 后跑
# tools/dev/retire_script_versions.py execute --yes（契约见 script-versioning.md 判据与巡检）。
ExecStart=<deploy-root>/venv/bin/python <deploy-root>/tools/dev/script_guard_probe.py
# 退出码语义由 probe 自己决定：--guard 报 1（有到期项）/2（事实不可得）算任务成功，
# 只有 3（工具自身异常）才让本任务 failed 进告警面。不要给上面的 ExecStart 加 - 前缀
# ——那会把「守卫坏了」也吞成成功。
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
ReadWritePaths=/var/lib/prometheus/node-exporter

[Install]
WantedBy=multi-user.target
