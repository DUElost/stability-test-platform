# Rendered by the site installer for <deploy-root> — do not edit by hand.
[Unit]
Description=STP skill usage probe (hollow detection, #2785)

[Service]
Type=oneshot
# #2881：改为**不降权**（与邻居 stp-script-guard / stp-mem-top 同款）——本单元现在要写
# root:root 的 textfile 指标目录（/var/lib/prometheus/node-exporter），而降权跑没有写权限。
# 转录源仍在部署用户家目录，故由 --home 显式指路（root 的 ~ 是 /root，找不到源）。
# 历史：此前降权到 <deploy-user> 是为了读转录（#2804：root 跑会按「无数据源」skip 退出 0，
# timer 恒绿却永远观测不到任何东西）；现在改由 --home 解决同一问题，且顺带补上了指标出口。
# ProtectHome=read-only 对 root 只读遍历 /home 无影响。
WorkingDirectory=<deploy-root>
# 退出码契约见 tools/dev/skill_usage_probe.py 模块头：0=跑完（无洞/有洞/缺源都算跑完，
# 洞数与未知交给指标与告警）；1=探针自身异常（判据崩溃/指标写不出去）→ unit failed，
# 由 systemctl --failed / journal 承接人审。不给 ExecStart 加 - 前缀，那会把
# 「探针坏了」吞成成功。--self-test 由 check:gov 的 gov-skills gate 承载，不在此重复。
ExecStart=<deploy-root>/venv/bin/python <deploy-root>/tools/dev/skill_usage_probe.py --home /home/<deploy-user> --deploy-root <deploy-root>
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
