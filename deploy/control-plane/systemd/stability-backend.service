[Unit]
Description=Stability Test Platform Backend
After=network.target

[Service]
Type=simple
# Replace with your deploy user, e.g. User=stability
User=<deploy-user>
WorkingDirectory=<deploy-root>
EnvironmentFile=<deploy-root>/.env.backend
# Keep schema in sync with the running code path before the single backend instance starts.
ExecStartPre=/bin/bash -lc 'cd <deploy-root>/backend && ../venv/bin/python -m alembic upgrade head'
# 部署源守卫（失败仅记日志不中断——硬失败 + Restart=always 会进 start-limit 循环致生产中断）
ExecStartPre=-<deploy-root>/tools/dev/check-deploy-source.sh
ExecStart=<deploy-root>/venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
StandardOutput=append:<deploy-root>/logs/backend.log
StandardError=append:<deploy-root>/logs/backend_error.log

[Install]
WantedBy=multi-user.target
