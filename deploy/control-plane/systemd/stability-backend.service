[Unit]
Description=Stability Test Platform Backend
After=network.target
# #2058：schema 对齐守卫是**硬** ExecStartPre（无减号），而服务是 Restart=always +
# RestartSec=5；没有 start-limit 时守卫一红就会每 5s 重跑「alembic upgrade + 守卫」
# 无限循环，把真实原因埋在 activating/auto-restart 里（2026-08-30 决策明确：
# 「无 StartLimit* 不得硬失败」）。给一个有界重试窗口后停在稳定 failed。
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
# Replace with your deploy user, e.g. User=stability
User=<deploy-user>
WorkingDirectory=<deploy-root>
EnvironmentFile=<deploy-root>/.env.backend
# Keep schema in sync with the running code path before the single backend instance starts.
ExecStartPre=/bin/bash -lc 'cd <deploy-root>/backend && ../venv/bin/python -m alembic upgrade head'
# #1882：schema 对齐硬门禁（无减号）——代码超前于库时拒绝启动，避免带病 500 对外服务。
# DATABASE_URL 来自 EnvironmentFile；不对齐则本步失败（优先于带着错误 schema 启动）。
ExecStartPre=<deploy-root>/venv/bin/python <deploy-root>/tools/dev/check_alembic_at_head.py
# 部署源守卫（分支/脏工作树：失败仅记日志不中断——硬失败 + Restart=always
# 会进 start-limit 循环致生产中断；schema 已由上一行硬拦）
ExecStartPre=-<deploy-root>/tools/dev/check-deploy-source.sh
ExecStart=<deploy-root>/venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
StandardOutput=append:<deploy-root>/logs/backend.log
StandardError=append:<deploy-root>/logs/backend_error.log

[Install]
WantedBy=multi-user.target
