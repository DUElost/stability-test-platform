[Unit]
Description=Stability Test Platform Backend DB Migration (oneshot)
After=network.target

[Service]
Type=oneshot
User=<deploy-user>
WorkingDirectory=<deploy-root>
EnvironmentFile=<deploy-root>/.env.backend
ExecStart=/bin/bash -lc 'cd <deploy-root>/backend && ../venv/bin/python -m alembic upgrade head'

[Install]
WantedBy=multi-user.target

