DATABASE_URL=postgresql+asyncpg://stp:password@localhost:5432/stp
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me-in-production
CORS_ORIGINS=https://stp.example.com
# CORS wildcards are rejected when credentials are enabled.
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Agent-Secret
SSH_CREDENTIALS_FERNET_KEY=
# STP_SSH_KNOWN_HOSTS=/etc/stp/known_hosts
# STP_SSH_LOG_ROOTS=/opt/stability-test-agent/logs,/var/log

# 旧名 HEARTBEAT_TIMEOUT_SECONDS / HEARTBEAT_CHECK_INTERVAL_SECONDS 与
# BACKPRESSURE_* 均无读取点，已于 #737 移除；心跳超时真实开关见下方三处
# （HOST_HEARTBEAT_TIMEOUT_SECONDS / PATROL_RUNNING_HEARTBEAT_TIMEOUT_SECONDS /
# RUNNING_HEARTBEAT_TIMEOUT_SECONDS）。

# Control-plane local prefix only. Script catalog requires STP_SCRIPT_ROOT.
# STP_NFS_ROOT=/mnt/storage/test-platform

# Script catalog scan source. Required; scan returns 503 if unset.
# STP_SCRIPT_ROOT=/opt/stability-test-platform/backend/agent/scripts

# Runtime root used by Linux agents after hot update. If set, script scan stores
# this path in script.nfs_path instead of the platform host's local scan path.
# STP_SCRIPT_RUNTIME_ROOT=/opt/stability-test-agent/agent/scripts

# Session watchdog (replaces overlapping recycler + heartbeat monitor checks)
# 常驻调度（session_watchdog_once），无开关；USE_SESSION_WATCHDOG 无读取点，已移除（#737）。
# Long patrol + scan may delay HTTP heartbeat; 300s recommended for real-device hosts.
HOST_HEARTBEAT_TIMEOUT_SECONDS=300
UNKNOWN_GRACE_SECONDS=300
SESSION_WATCHDOG_INTERVAL_SECONDS=15

# WebSocket auth (see ADR-0009) + ADR-0024 Cookie session
# Production: ENV=production triggers validate_production_auth_cookie_settings()
ENV=production
AUTH_COOKIE_SECURE=1
AUTH_COOKIE_SAMESITE=lax
STP_CSRF_ENABLED=1
STP_METRICS_AUTH_REQUIRED=1
# In-process SAQ worker (set 0 only when running a dedicated SAQ process)
STP_ENABLE_INPROCESS_SAQ=1
# Startup Redis probe timeout (seconds) when STP_ENABLE_INPROCESS_SAQ=1
# REDIS_PING_TIMEOUT=3
# Non-production only: skip Redis PING and in-process SAQ startup (TESTING=1 also skips lifespan infra)
# STP_SKIP_INFRA_CHECK=0

# Job / lease timeouts (production defaults in job_timeout_config.py)
# PATROL_RUNNING_HEARTBEAT_TIMEOUT_SECONDS=300
# DISPATCH_SYNC_MAX_ATTEMPTS=1
# Static shared secret for browser WS token validation (fallback when JWT unavailable)
WS_TOKEN=change-me-in-production
# Agent WS authentication secret (must match agent-side AGENT_SECRET)
AGENT_SECRET=change-me-in-production

# Linux control plane defaults
# STP_SCRIPT_ROOT=/opt/stability-test-platform/backend/agent/scripts
# STP_SCRIPT_RUNTIME_ROOT=/opt/stability-test-agent/agent/scripts

# Agent 首次安装（POST /hosts/{id}/install）把该地址写进 Agent .env 的 API_URL。
# 必须是站点公开入口的纯 origin（Agent 自行拼 /api/v1 与 WS 路径）；缺键时
# 安装接口返回 400 而不是装出连错地址的 Agent。站点安装由 S2 按 public_url 渲染。
# STP_AGENT_INSTALL_API_URL=https://stp.example.com

# ADR-0025: 中心存储（CIFS）mount. Backend and agents share one UNC;
# path strings may differ.
# STP_AEE_NFS_ROOT=/mnt/nfs/aee_events
# STP_DEDUP_SCAN_PYTHON / SCRIPT are the control plane's own paths (run_merge_sync).
# The STP_AGENT_ pair is what hot-update writes to every agent — the tool sits at a
# different location there, so a single shared value cannot serve both roles.
# STP_DEDUP_SCAN_PYTHON=/usr/bin/python3
# STP_DEDUP_SCAN_SCRIPT=/opt/stability_Start-Log-Scan/start_log_scan.py
# STP_AGENT_DEDUP_SCAN_PYTHON=/mnt/nfs/aee_events/tools/Start-Log-Scan/venv/bin/python
# STP_AGENT_DEDUP_SCAN_SCRIPT=/mnt/nfs/aee_events/tools/Start-Log-Scan/start_log_scan.py
# STP_DEDUP_SCAN_TAG=shanghai
# STP_DEDUP_AUTO_SCAN=1

# ADR-0031: 平台 AI 助手。LLM API Key 的 Fernet 加密密钥——独立密钥域，
# 勿复用 SSH_CREDENTIALS_FERNET_KEY。未配置时 AI 助手功能降级（config 接口
# 报「未配置」），不影响平台其余功能。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AI_ASSISTANT_FERNET_KEY=
