# PostgreSQL Configuration
POSTGRES_USER=stability
# 必填：留空或未设置时 compose 拒绝启动。生成示例：openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=stability_platform
POSTGRES_PORT=5432

# PgAdmin Configuration (optional, docker compose --profile admin)
PGADMIN_EMAIL=admin@example.com
# 必填：compose 插值不区分 profile，未启用 admin profile 时也须设置（同上生成）
PGADMIN_PASSWORD=
PGADMIN_PORT=5050

# Backend Database URL（将 <password> 替换为上面的 POSTGRES_PASSWORD）
DATABASE_URL=postgresql://stability:<password>@localhost:5432/stability_platform
