FROM python:3.11-slim

WORKDIR /app

# 只装运行时依赖 —— requirements-dev.txt(pytest / testcontainers / ruff)
# 刻意不进生产镜像。
#
# 装的是 lock 而非 requirements.txt:后者是区间约束,同一份代码在不同时间
# 构建会拿到不同的传递依赖版本。--require-hashes 同时保证下载物未被篡改。
# 改依赖的流程:改 requirements.txt → 重新生成 lock(命令见 lock 抬头)。
COPY backend/requirements.lock .
RUN pip install --no-cache-dir --require-hashes -r requirements.lock

COPY backend/ backend/
RUN useradd --system --create-home --home-dir /home/appuser appuser \
    && chown -R appuser:appuser /app

ENV PYTHONPATH=/app
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD python -c "from urllib.request import urlopen; import sys; sys.exit(0 if urlopen('http://127.0.0.1:8000/health', timeout=3).getcode() == 200 else 1)"

USER appuser

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
